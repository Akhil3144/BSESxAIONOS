LLM_ENABLED=false
LLM_DATA_APPROVAL_REF=
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15
# Optional case-chat language routing; also requires all approved LLM settings above.
LLM_CHAT_ENABLED=false
